{
  "name": "instansender",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "cd frontend && bun run dev",
    "dev:backend": "cd backend && bun run dev",
    "db:push": "cd backend && bun run db:push",
    "db:generate": "cd backend && bun run db:generate",
    "db:studio": "cd backend && bun run db:studio",
    "test:frontend": "cd frontend && bun run test",
    "test:backend": "cd backend && bun run test:unit",
    "test:e2e": "cd backend && bun run test:e2e",
    "test": "bun run test:backend && bun run test:frontend",
    "build:frontend": "cd frontend && bun run build",
    "build": "bun run build:frontend",
    "typecheck": "cd backend && bun run check",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  }
}
