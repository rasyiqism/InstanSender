# Database (PostgreSQL) eksternal / managed / Dokploy service
# Contoh: postgresql://username:password@host:5432/database_name?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/neowa
DB_SSL=false

# Redis eksternal / Dokploy service / Upstash
# Contoh: redis://[:password@]host:6379
REDIS_URL=redis://host:6379
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1d
APP_URL=https://notifpod.my.id
WA_CONNECTOR_TOKEN=hythntyhy5r32462fc23tyfdtyefytwefewfwefewf
WA_DEVICE_NAME=Simpe Sender
TZ=Asia/Jakarta

# External integration provisioning (POST /v1/provisioning/subscription)
PROVISIONING_TOKEN=provisioning-secret-change-me-in-production

# Third-party agency creation (POST /internal/agency, x-internal-token header).
# Empty = endpoint rejects all requests (fail-closed).
INTERNAL_API_TOKEN=replace-with-a-long-random-token

# Email SMTP
NOTIFICATION_BRAND_NAME=NotifPod
NOTIFICATION_BRAND_TAGLINE=WhatsApp Notification Gateway
# Leave empty to use the default footer with NOTIFICATION_BRAND_NAME.
NOTIFICATION_EMAIL_FOOTER=
SMTP_HOST=live.smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=smtp@mailtrap.io
SMTP_PASSWORD=d26a47bb631fb4415498d8493cd7a2e7
MAIL_FROM=NotifPod <no-reply@notifpod.my.id>

# UUID device WhatsApp yang sudah connected untuk notifikasi sistem
NOTIFICATION_WA_DEVICE_ID=

# Admin pertama. Hapus nilainya setelah akun berhasil dibuat.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Rekening pembayaran
BANK_NAME=BCA
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_HOLDER=
BCA_ACCOUNT_NUMBER=
BCA_ACCOUNT_HOLDER=
BRI_ACCOUNT_NUMBER=
BRI_ACCOUNT_HOLDER=

# Alternatif konfigurasi rekening dalam JSON satu baris
BANK_ACCOUNTS_JSON=

