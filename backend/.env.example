# App
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
# Either DATABASE_URL or discrete DB_* vars work. DATABASE_URL takes precedence.
DATABASE_URL=postgres://postgres:password@localhost:5433/simplesender
# DB_HOST=localhost
# DB_PORT=5433
# DB_USERNAME=postgres
# DB_PASSWORD=password
# DB_DATABASE=simplesender

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d
APP_URL=http://localhost:5173

# Initial admin seed (required in production when provisioning a fresh database)
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=use-a-strong-password

# Redis (queue + rate limit)
# Either REDIS_URL or discrete REDIS_* vars work. REDIS_URL takes precedence.
# REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# WA Connector Service (Go + whatsmeow) internal API
WA_CONNECTOR_URL=http://127.0.0.1:8080
WA_CONNECTOR_TOKEN=hythntyhy5r32462fc23tyfdtyefytwefewfwefewf

# External integration provisioning (POST /api/v1/provisioning/subscription)
PROVISIONING_TOKEN=provisioning-secret-change-me-in-production

# System notifications
# Use a connected device UUID as the sender for WhatsApp notifications.
NOTIFICATION_WA_DEVICE_ID=
NOTIFICATION_BRAND_NAME=NotifPod
NOTIFICATION_BRAND_TAGLINE=WhatsApp Notification Gateway
# Leave empty to use the default footer with NOTIFICATION_BRAND_NAME.
NOTIFICATION_EMAIL_FOOTER=
SMTP_HOST=live.smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=smtp@mailtrap.io
SMTP_PASSWORD=d26a47bb631fb4415498d8493cd7a2e7
MAIL_FROM=NotifPod <no-reply@notifpod.my.id>

# Manual bank transfer
BANK_NAME=BCA
BANK_ACCOUNT_NUMBER=1234567890
BANK_ACCOUNT_HOLDER=PT Neowa Indonesia
BCA_ACCOUNT_NUMBER=1234567890
BCA_ACCOUNT_HOLDER=PT Neowa Indonesia
BRI_ACCOUNT_NUMBER=9876543210
BRI_ACCOUNT_HOLDER=PT Neowa Indonesia

# Uploads (bukti transfer)
UPLOAD_DIR=./uploads


INTERNAL_API_TOKEN=internal-api-secret-change-me-in-production