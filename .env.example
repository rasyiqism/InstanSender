# -------------------------------------------------------------
# InstanSender - Environment Configuration Template
# -------------------------------------------------------------

# App Configuration
PORT=3000
APP_NAME=InstanSender
APP_URL=http://localhost:5173

# Database & Cache (External - Not bundled in compose)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/simplesender
REDIS_URL=redis://localhost:6379
DB_SSL=false

# Authentication
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# WhatsApp Connector
WA_CONNECTOR_URL=http://localhost:8080
WA_CONNECTOR_TOKEN=replace_with_secure_random_connector_token_12345
WA_DEVICE_NAME=InstanSender

# Internal API & Provisioning
PROVISIONING_TOKEN=replace_with_secure_provisioning_token
INTERNAL_API_TOKEN=replace_with_secure_internal_api_token
NOTIFICATION_WA_DEVICE_ID=

# Bank Transfer Settings
BANK_NAME=BCA
BANK_ACCOUNT_NUMBER=1234567890
BANK_ACCOUNT_HOLDER=PT Instan Sender Indonesia

# SMTP / Email Notifications (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@instansender.id
EMAIL_MOCK=true

# Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5
